{
  "id": null,
  "uid": "fortigate-40f",
  "title": "FortiGate 40F",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["fortigate", "network"],
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "stat", "id": 1, "title": "Probe success",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_success{job=\"fortigate\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}]}}
    },
    {
      "type": "timeseries", "id": 2, "title": "CPU %",
      "gridPos": {"h": 8, "w": 10, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "fortigate_cpu_usage_ratio * 100", "legendFormat": "CPU", "refId": "A"}]
    },
    {
      "type": "timeseries", "id": 3, "title": "Memory %",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "fortigate_memory_usage_ratio * 100", "legendFormat": "RAM", "refId": "A"}]
    },
    {
      "type": "timeseries", "id": 4, "title": "Sessions",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "fortigate_current_sessions", "legendFormat": "sessions", "refId": "A"}]
    },
    {
      "type": "timeseries", "id": 5, "title": "Interface bits/s",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(fortigate_interface_receive_bytes_total[5m]) * 8", "legendFormat": "rx {{name}}", "refId": "A"},
        {"expr": "rate(fortigate_interface_transmit_bytes_total[5m]) * 8", "legendFormat": "tx {{name}}", "refId": "B"}
      ]
    }
  ]
}

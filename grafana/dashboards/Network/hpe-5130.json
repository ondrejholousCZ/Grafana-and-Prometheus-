{
  "id": null,
  "uid": "hpe-5130",
  "title": "HPE 5130 Switch",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["hpe", "snmp", "switch"],
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "type": "stat", "id": 1, "title": "SNMP up",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "up{job=\"snmp-comware\",instance=\"10.0.90.11\"}", "refId": "A"}]
    },
    {
      "type": "timeseries", "id": 2, "title": "Board CPU %",
      "gridPos": {"h": 8, "w": 10, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "comware_entity_cpu_usage_percent{instance=\"10.0.90.11\",entity_name=\"Board\"}", "legendFormat": "Board CPU", "refId": "A"}]
    },
    {
      "type": "timeseries", "id": 3, "title": "Temperature °C",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "comware_entity_temperature_celsius{instance=\"10.0.90.11\"}", "legendFormat": "{{entity_name}}", "refId": "A"}]
    },
    {
      "type": "timeseries", "id": 4, "title": "Interface traffic (bits/s)",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rate(ifHCInOctets{instance=\"10.0.90.11\"}[5m]) * 8", "legendFormat": "in {{ifName}}", "refId": "A"},
        {"expr": "rate(ifHCOutOctets{instance=\"10.0.90.11\"}[5m]) * 8", "legendFormat": "out {{ifName}}", "refId": "B"}
      ]
    },
    {
      "type": "table", "id": 5, "title": "Port status",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 18},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "ifOperStatus{instance=\"10.0.90.11\"}", "format": "table", "instant": true, "refId": "A"}],
      "transformations": [
        {"id": "labelsToFields", "options": {}},
        {"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true}, "renameByName": {"Value": "operStatus", "ifName": "port"}}}
      ]
    }
  ]
}
